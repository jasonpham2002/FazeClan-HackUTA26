# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Meta Model API key. Sent only to https://api.meta.ai. Do not put this in OPENAI_API_KEY.
MODEL_API_KEY=YOUR_META_MODEL_API_KEY
MUSE_MODEL=muse-spark-1.3

# ElevenLabs hears the caller and speaks the reply. Sent only to https://api.elevenlabs.io.
ELEVEN_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVEN_MODEL=eleven_flash_v2_5
# Optional voice id from the ElevenLabs voice library. Blank uses the plugin default.
ELEVEN_VOICE_ID=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=faze-interview

# Chert project key from Developer -> Project API keys. Sent only to facetime.trychert.com.
CHERT_API_KEY=ftk_YOUR_PROJECT_API_KEY
CHERT_PROJECT_ID=a7a842f3-9794-452a-8a43-01e7dbf9de14
CHERT_LINE_ID=05d72268-0384-45ae-ae38-a4b36e005286
