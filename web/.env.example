# fixtures = sample data stored in this browser (clearly labelled in the UI)
# live     = Jason's API; failures are shown as errors, never replaced by fixtures
VITE_DATA_SOURCE=fixtures

# Base URL of the API, used only when VITE_DATA_SOURCE=live (no trailing slash)
VITE_API_BASE_URL=

# Public URL of the backend's real sign-in/profile service (live mode only)
VITE_SIGN_IN_URL=
